<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block direct web access to git metadata and deploy sync state
  RewriteRule ^(\.git|\.ftp-deploy-sync-state\.json) - [F,L]

  # Main-domain-only rules (never touches subdomains like erp_knitik, consultation, KnitikOS, etc.)
  RewriteCond %{HTTP_HOST} ^(www\.)?knitik\.com$ [NC]
  RewriteRule ^$ index.html [L]

  RewriteCond %{HTTP_HOST} ^(www\.)?knitik\.com$ [NC]
  RewriteRule ^(server\.js|package\.json|README\.md|\.gitignore)$ - [F,L]

  # Legacy redirects matching server.js (main domain only)
  RewriteCond %{HTTP_HOST} ^(www\.)?knitik\.com$ [NC]
  RewriteRule ^contact(\.html)?/?$ /#about [R=301,NE,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?knitik\.com$ [NC]
  RewriteRule ^case-studies(\.html)?/?$ /#results [R=301,NE,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?knitik\.com$ [NC]
  RewriteRule ^terms(\.html)?/?$ /#terms-and-conditions [R=301,NE,L]

  # Clean extensionless URLs (main domain only)
  RewriteCond %{HTTP_HOST} ^(www\.)?knitik\.com$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|webp|svg|gif|ico|css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
